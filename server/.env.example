NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://helpdesk:helpdesk@localhost:5434/helpdesk
TEST_DATABASE_URL=postgresql://helpdesk:helpdesk@localhost:5435/helpdesk_test

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_DAYS=7

# leave the key empty to run with the local keyword fallback only
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# comma separated, tried in this order
OPENROUTER_MODELS=
AI_TIMEOUT_MS=15000
AI_DAILY_QUOTA_PER_USER=50

OUTAGE_MIN_TICKETS=5
OUTAGE_WINDOW_MINUTES=30
