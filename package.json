{
  "name": "helpdesk",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "test": "npm run test -w server",
    "lint": "eslint .",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "format": "prettier --write .",
    "db:migrate": "npm run db:migrate -w server",
    "seed": "npm run seed -w server",
    "seed:demo": "npm run seed:demo -w server",
    "demo:outage": "npm run demo:outage -w server --",
    "demo:clear": "npm run demo:clear -w server --",
    "ai:eval": "npm run ai:eval -w server --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.2"
  }
}
